# AI_PROVIDER selects which AI backend the demand forecaster and SmartRent
# Copilot use: "gemini" (direct Google API key) or "openrouter". If unset,
# the server prefers Gemini and falls back to whichever provider actually has
# a key configured. Frontend code never sees these keys -- only server.ts and
# src/services/aiProvider.ts touch them.
AI_PROVIDER="gemini"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.6-flash"

# Optional alternative provider: an OpenRouter API key (starts with sk-or-v1-)
# instead of a direct Gemini key. Only used when AI_PROVIDER=openrouter, or as
# a fallback if GEMINI_API_KEY is absent.
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemini-3.6-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# For physical phone QR scans on the same Wi-Fi, use your computer's LAN URL,
# for example: VITE_APP_URL="http://192.168.1.20:3000"
VITE_APP_URL=""

# Optional: real SMS delivery. When absent, notifications are safely recorded
# as simulations in the audit trail. Keep real values only in .env, never Git.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
ALERT_MANAGER_PHONE=""
ALERT_CUSTOMER_PHONE=""
